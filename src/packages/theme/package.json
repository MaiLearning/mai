{
  "name": "@mai/theme",
  "version": "0.1.0",
  "description": "Темизация и UI-примитивы Mai",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./base": {
      "types": "./src/base/provider.tsx",
      "import": "./src/base/provider.tsx"
    },
    "./ui/button": {
      "types": "./src/ui/base/button/button.tsx",
      "import": "./src/ui/base/button/button.tsx"
    },
    "./ui/text": {
      "types": "./src/ui/base/text/text.tsx",
      "import": "./src/ui/base/text/text.tsx"
    },
    "./ui/*": {
      "types": "./src/ui/*",
      "import": "./src/ui/*"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.5.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.6.0",
    "styled-components": "^6.5.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "lucide-react": "^0.475.0"
  }
}
