{
  "files.exclude": {
    "**/.git": false
  },
  "rust-analyzer.linkedProjects": ["platform/src-tauri/Cargo.toml"],
  // Автосохранение через 1 секунду после изменения
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  // Автоформатирование и линтинг
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // Настройки шрифта
  "editor.fontFamily": "JetBrains Mono, Fira Code, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12.5,
  "editor.lineHeight": 1.7,
  "editor.letterSpacing": 0.1,
  // Визуальные удобства
  // Вертикальные направляющие для длины строк
  "editor.rulers": [100, 120],
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.matchBrackets": "always",
  // Включаем breadcrumbs (путь файла и структура методов сверху)
  "breadcrumbs.enabled": true,
  // Ну и прочее по мелочи
  "workbench.colorTheme": "Dark+",
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  // Что то левое...
  "editor.guides.indentation": true,
  "cmake.ignoreCMakeListsMissing": true,
  // Разрешить загрузку внешних JSON схем (opencode.ai → models.dev)
  "json.schemaDownload.enable": true,
  // JSON схемы для Tauri конфигов, и opencode.
  "json.schemas": [
    {
      "fileMatch": ["tauri.conf.json", "tauri.config.json"],
      "url": "https://schema.tauri.app/config/2"
    },
    {
      "fileMatch": ["opencode.json"],
      "url": "https://opencode.ai/config.json"
    },
    {
      "url": "https://biomejs.dev/schemas/2.5.9/schema.json"
    }
  ]
}
